+import Link from "next/link";
+import { Callout, CodeBlock, DocHeader, DocsShell, StatusPill } from "../../ui";
+import { engineVersion } from "../../generated/engineVersion";
+
+const speechSample = `Speech speech(GetGameObject());
+speech.Start();
+const std::string text = speech.GetLastText();
+const float confidence = speech.GetLastConfidence();`;
+
+const onlineSample = `Online::SetPlayerIdentity("player-001", "Player");
+Online::SubmitScore("main", 12500, OnlineLeaderboardScope::Global);`;
+
+export default function ExternalIntegrationPage() {
+  return <DocsShell>
+    <DocHeader eyebrow="EXTERNAL INTEGRATION / 07" title="外部DeviceとOnlineを、ゲーム本体から分離して使う。" lead="Speech、Vision、Haptics、Online Servicesを、Component設定・Debug Window・C++ Scriptから安全に接続するための利用者向け手順です。使えない環境でもGameplayを止めない前提で説明します。" meta={`ENGINE / ${engineVersion.display} · API VERSION / ${engineVersion.scriptApi} · 4 SYSTEMS`} />
+    <div className="doc-badge-row"><StatusPill tone="partial">SPEECH</StatusPill><StatusPill tone="partial">VISION</StatusPill><StatusPill tone="partial">HAPTICS</StatusPill><StatusPill tone="partial">ONLINE</StatusPill></div>
+    <Callout title="外部機能は必須条件にしない" tone="warning"><p>マイク、Camera、FeelKit Device、Network、Backend、Model、権限は実行環境で使えないことがあります。状態が<code>Unavailable</code>や<code>Error</code>でも、通常の入力・保存・Gameplayへ代替経路を残します。</p></Callout>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">SETUP ORDER</p><h2>設定する順番</h2></div><div className="numbered-steps"><article><span>01</span><h3>Componentを追加</h3><p>SpeechRecognizer、CameraInput、ImageRecognizer、HapticSourceを対象GameObjectへ追加します。</p></article><article><span>02</span><h3>BackendとDeviceを確認</h3><p>Debug WindowでDevice、Backend、Model、権限、状態、最終Errorを確認します。自動で未対応Backendへ切り替えません。</p></article><article><span>03</span><h3>Actionへ接続</h3><p>Keyword、検出、色、動きの結果はInput ActionまたはScript Actionへ接続します。Keyboard/Gamepadの代替入力も残します。</p></article><article><span>04</span><h3>Playと配布を分けて確認</h3><p>EditorのPreviewだけで成功扱いにせず、Standalone、実Device、Worker URL、Client Keyを別々に確認します。</p></article></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">SPEECH / VISION</p><h2>認識結果を入力へ流す</h2></div><div className="two-column-doc"><div><h3>Speech</h3><p>Keywordなら認識時Actionへ流し、文字起こしの表示だけが必要な場合にScriptから確定済みの直近結果を読みます。言語、Keyword、Confidence、Action Map名を一致させます.</p><CodeBlock code={speechSample} /></div><div><h3>Vision</h3><p>CameraInputを複数のRecognizerで共有できます。色追跡・動体検出は内蔵Backend、物体・分類・顔検出は対応するONNX ModelとLabel Fileを指定します。顔ランドマークやMediaPipeは未対応です。</p></div></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">HAPTICS / ONLINE</p><h2>触覚とOnline Services</h2></div><div className="two-column-doc"><div><h3>Haptics</h3><p>HapticSourceの強さ、持続時間、Patternを設定し、必要なら再生HandleをScriptで制御します。Device未接続でもゲーム進行を成功条件にしません。</p></div><div><h3>Online</h3><p>Cloudflare WorkerのDevelopment / Production URL、Game ID、Client Key、Player IDをProject Settingsへ設定します。開発Databaseと本番Databaseを分離し、QueueとHTTP状態をDebug Windowで確認します。</p><CodeBlock code={onlineSample} /></div></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">FAILURE CONTRACT</p><h2>動かない時の確認先</h2></div><div className="detail-card-grid"><article><span>DEVICE</span><h3>権限と接続</h3><p>Windows権限、Device一覧、Capture FPS、マイク入力、FeelKit接続を確認します。</p></article><article><span>BACKEND</span><h3>Modelと状態</h3><p>Backend名、Model入力Shape、Label、Confidence、推論間隔、状態とError Codeを確認します。</p></article><article><span>NETWORK</span><h3>URLとQueue</h3><p>Active URL、HTTP Status、Pending Queue、Worker環境、Client Key、Timeoutを確認します。</p></article></div><Link className="text-link" href="/docs/troubleshooting">トラブルシューティングを見る →</Link></section>
+  </DocsShell>;
+}
