+import Link from "next/link";
+import { DocHeader, DocsShell } from "../../../ui";
+
+export default function ExternalIntegrationInternalsPage() {
+  return <DocsShell><DocHeader eyebrow="INTERNAL SPEC / EXTERNAL SYSTEMS" title="外部連携の所有権とThread境界" lead="Speech、Vision、Haptics、OnlineのBackend、Device、Worker Thread、Main Threadの責務をまとめます。" meta="SOURCE / external-integration-internals.md" />
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">LAYERING</p><h2>SystemとBackendの境界</h2></div><div className="detail-card-grid"><article><h3>Editor接続</h3><p>ComponentとScript WrapperからExternal Feature Manager / OnlineServiceを経て各Systemへ渡します。</p></article><article><h3>Backend</h3><p>Speech、Vision、Haptics、OnlineのSystemがBackend Interfaceを所有します。</p></article><article><h3>Platform SDK</h3><p>SAPI、Media Foundation、ONNX Runtime、FeelKit、WinHTTP固有型はBackend内へ閉じます。</p></article></div><p className="section-intro">上位層へ渡すのはEngine独自のPlain Dataです。OS Handle、SDK固有型、Session PointerはBackendの外へ出しません。</p></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">THREAD OWNERSHIP</p><h2>Threadごとの責務</h2></div><div className="detail-card-grid"><article><span>MAIN</span><h3>GameとCallback</h3><p>Component登録、System Update、Script API、Input Action、UI、Online Callbackを実行します。</p></article><article><span>CAPTURE</span><h3>Camera Frame</h3><p>Capture ThreadがBGRA Frameを更新し、Main Threadは最新Frameを受け取ります。Capture側からSceneやImGuiへ触れません。</p></article><article><span>ONLINE</span><h3>Network Request</h3><p>Worker ThreadはRequestを直列処理してResponse Queueへ積みます。Gameplay CallbackはMain Threadで呼びます。</p></article></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">SHUTDOWN</p><h2>停止時の解放順</h2></div><p className="section-intro">停止を通知してThreadをjoinし、その後にMedia Foundation、WinHTTP Handle、Backend、Session、Queueを解放します。Play停止時にCallbackを外し、次のPlayへ前回のSessionを残しません。</p><Link className="text-link" href="/docs/external-integration">外部連携の設定と使い方 →</Link></section>
+    <Link className="text-link" href="/docs/internal-specs">内部仕様の分野一覧へ →</Link>
+  </DocsShell>;
+}
