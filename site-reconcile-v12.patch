+import Link from "next/link";
+import { Callout, DocHeader, DocsShell, StatusPill } from "../../ui";
+
+const internalTopics = [
+  ["01", "全体内部設計", "mainからScene、GameObject、Componentへ至る所有関係、起動順、Update/Draw順、拡張規約。"],
+  ["02", "Runtimeサブシステム", "Play開始・停止、Manager依存、時間、PhysicsとScriptの境界、Event、Reset、Error境界。"],
+  ["03", "データ保存・互換性", "Project、Scene、Prefab、Asset Registry、Hash、依存、Backup、Invite、共同制作Change Log。"],
+  ["04", "Rendering Pipeline", "DirectX 12 Pass、GPU Resource、Barrier、Scene/Game View、Temporal History、Bloom、SMAA、SSR。"],
+  ["05", "外部連携内部設計", "Speech、Vision、Haptics、OnlineのBackend、Thread、Memory、Device失敗、DirectX/GL境界。"],
+  ["06", "共同制作内部設計", "CG2TeamServer、認証、Revision、Scene/Asset同期、TeamItem、Lock、Conflict、永続化。"],
+];
+
+export default function InternalSpecsPage() {
+  return <DocsShell>
+    <DocHeader eyebrow="INTERNAL SPECIFICATIONS / ENGINEERING" title="内部仕様を、利用者向け説明から分離する。" lead="ここはEngineを拡張・保守する人向けの設計説明です。利用者がComponentやWindowを使う手順ではなく、所有関係、寿命、Thread、保存契約、描画Pass、通信責務を扱います。" meta="ENGINEERING REFERENCE / 2026.09.26 · NOT A USER GUIDE" />
+    <div className="doc-badge-row"><StatusPill tone="experimental">ENGINEERING</StatusPill><StatusPill tone="partial">SOURCE CONTRACT</StatusPill><StatusPill tone="stable">SEPARATE FROM USER GUIDE</StatusPill></div>
+    <Callout title="利用者向けページと混ぜない" tone="warning"><p>操作手順、Inspectorの値、Componentの組み合わせ、C++ APIの使い方は通常のドキュメントを参照してください。内部仕様では、それらを実装する所有者・順序・境界・復旧契約だけを説明します。</p></Callout>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">INTERNAL MAP</p><h2>分野別の内部説明</h2></div><div className="doc-card-grid">{internalTopics.map(([number, title, copy]) => <article className="doc-topic-card" key={number}><span className="doc-topic-number">{number}</span><h3>{title}</h3><p>{copy}</p><div className="topic-tags"><span>内部設計</span><span>Source照合</span></div></article>)}</div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">BOUNDARY RULES</p><h2>内部仕様で固定するもの</h2></div><div className="detail-card-grid"><article><span>OWNERSHIP</span><h3>責務を一箇所に置く</h3><p>mainやGameSceneへ処理を集中させず、Scene、Object、Component、Manager、Systemの所有関係を維持します。</p></article><article><span>LIFETIME</span><h3>開始と停止を対にする</h3><p>Thread、Backend、Handle、Queue、GPU Resourceは開始順と停止順を明記し、次のPlayへ状態を残しません。</p></article><article><span>COMPATIBILITY</span><h3>既存形式を壊さない</h3><p>Sceneの未知行、APIの末尾拡張、Project Version、BackupとConflictを前提に変更します。</p></article></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">RETURN TO USER DOCS</p><h2>利用者向け説明へ戻る</h2></div><div className="link-grid"><Link href="/docs/engine-spec">現行Engine仕様 →</Link><Link href="/docs/user-guide">利用者ガイド →</Link><Link href="/docs/cpp-scripting">C++ API →</Link><Link href="/docs/external-integration">外部連携の使い方 →</Link></div></section>
+  </DocsShell>;
+}
