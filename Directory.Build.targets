<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Target Name="SyncManoEngineVersion" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'ManoEngine' or '$(MSBuildProjectName)' == 'ManoLauncher'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Tools\Versioning\Sync-Version.ps1&quot;" />
  </Target>
  <PropertyGroup Condition="'$(MANOENGINE_ASAN)' == '1' and '$(MSBuildProjectName)' == 'ManoEngine'">
    <OutDir>x64\ReleaseASan\</OutDir>
    <IntDir>x64\ReleaseASan\obj\</IntDir>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MANOENGINE_ASAN)' == '1' and '$(MSBuildProjectName)' == 'ManoEngine'">
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) /fsanitize=address</AdditionalOptions>
      <PreprocessorDefinitions>%(PreprocessorDefinitions);_DISABLE_VECTOR_ANNOTATION;_DISABLE_STRING_ANNOTATION</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) /fsanitize=address</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
