+﻿import Link from "next/link";
+import { Callout, DocHeader, DocsShell, StatusPill } from "../../ui";
+
+const guideSteps = [
+  ["01", "LauncherでProjectを開く", "Engine Version、Project Format、参加コードを確認してからEditorを起動します。"],
+  ["02", "SceneとComponentを作る", "GameObjectを配置し、InspectorでTransform、参照Asset、Componentの値を入力します。"],
+  ["03", "Playで検証する", "Game View、Console、Physics Debug、Diagnosticsを順に確認します。Stop後に編集値へ戻るのは正常です。"],
+  ["04", "AssetとScriptを管理する", "Project Viewから移動・Reimportし、DLLはScript API Versionが一致するDebug/Releaseを指定します。"],
+  ["05", "Buildと共同制作へ進む", "起動Sceneと参照Assetを選び、必要ならTEAMからRevision、Lock、Conflictを確認します。"],
+] as const;
+
+export default function UserGuidePage() {
+  return <DocsShell><DocHeader eyebrow="USER GUIDE / 01" title="最初のProjectからBuildまで。" lead="ManoEngineを初めて使う人向けに、Launcher、Scene、Component、Play、Script、Build、共同制作の基本順序をまとめます。" meta="SOURCE REVIEW / 2026.09.25 · USER WORKFLOW" /><div className="doc-badge-row"><StatusPill tone="stable">START HERE</StatusPill><StatusPill tone="partial">PLAY CHECK</StatusPill><StatusPill tone="note">BUILD READY</StatusPill></div>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">WORKFLOW</p><h2>この順番で進める</h2></div><div className="numbered-steps">{guideSteps.map(([number, title, body]) => <article key={title}><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">EDITOR MAP</p><h2>画面の役割を分ける</h2></div><div className="detail-card-grid"><article className="detail-card"><h3>Scene / Game View</h3><p>Scene Viewは配置とDebug、Game ViewはCamera Componentからの実行画面です。両者のCameraとTemporal Historyを混同しません。</p></article><article className="detail-card"><h3>Inspector / Project</h3><p>Inspectorは選択Objectの値、ProjectはAsset作成・移動・Reimport・依存確認を扱います。</p></article><article className="detail-card"><h3>Console / Diagnostics</h3><p>ConsoleはErrorや状態Message、DiagnosticsはCPU/GPU、VRAM、Physics、Frame Spikeの切り分けに使います。</p></article></div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">NEXT</p><h2>目的別に進む</h2></div><div className="link-grid"><Link href="/docs/components">Componentを探す →</Link><Link href="/docs/cpp-scripting">C++ APIを読む →</Link><Link href="/docs/editor-windows">Editor Windowを開く →</Link><Link href="/docs/troubleshooting">症状から直す →</Link></div><Callout title="保存してから終了するもの" tone="note"><p>Scene、Project Settings、Input Action、Animation、Effect、Material、TEAM設定、Native Script Source/DLLは明示的に保存します。Play中のHPや生成Objectは編集設定ではありません。</p></Callout></section>
+  </DocsShell>;
+}
