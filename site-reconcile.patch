+﻿import { Callout, DocHeader, DocsShell, StatusPill } from "../../ui";
+
+const checks = [
+  ["白画面・何も描画されない", "Active Camera、Priority、Near/Far、Renderer、Missing Asset、Viewportサイズ、DX12/Shader Errorを確認する。"],
+  ["当たり判定がずれる", "World位置・回転・Scale、ColliderのCenter/Size、親Transform、負Scale、Play中のJolt Shape、接触点を比較する。"],
+  ["C++ Scriptが動かない", "DLL Path、Architecture、Runtime API Version 13、Export関数、Load結果、旧DLL継続状態を確認する。"],
+  ["PostProcessが効かない", "PostProcess/VolumeのActive、Bloom、AA Mode、Scene/Game View、Diagnosticsの対象Passを確認する。"],
+  ["共同制作へ接続できない", "Server Host/Port、Protocol 3、Engine/Project/Script Version、Project ID、Tailscale MagicDNS、Firewallを確認する。"],
+] as const;
+
+export default function TroubleshootingPage() {
+  return <DocsShell><DocHeader eyebrow="TROUBLESHOOTING / 11" title="推測せず、実値から切り分ける。" lead="症状ごとの確認場所を、Console、Status、実座標、保存File、接続診断の順にまとめます。" meta="SOURCE REVIEW / 2026.09.25 · DIAGNOSTIC CHECKLIST" /><div className="doc-badge-row"><StatusPill tone="note">CONSOLE FIRST</StatusPill><StatusPill tone="partial">RUNTIME VALUES</StatusPill><StatusPill tone="stable">RECOVERY SAFE</StatusPill></div>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">SYMPTOM MAP</p><h2>症状から確認する</h2></div><div className="topic-index">{checks.map(([title, body], index) => <article key={title}><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
+    <section className="doc-section"><div className="doc-section-title"><p className="eyebrow">SAFE RECOVERY</p><h2>復旧前に上書きしない</h2></div><div className="two-column-doc"><div><h3>保存</h3><p>Scene保存失敗時は元Fileを削除せず、一時File、Read Only、別ProcessのLock、Project Versionを確認します。</p></div><div><h3>共同制作</h3><p><code>.team/change-log.jsonl</code>、<code>.team/backups</code>、<code>.team/trash</code>、<code>.team/conflicts</code>を確認してから採用結果を決めます。</p></div></div><Callout title="Build成功は画面表示成功の証明ではない" tone="warning"><p>Editor起動、Scene View、Game View、実音、Physics Debug、Standaloneはそれぞれ別に確認します。</p></Callout></section>
+  </DocsShell>;
+}
